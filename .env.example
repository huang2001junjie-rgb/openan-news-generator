# 公司统一网关地址（开发阶段代理目标，浏览器同源请求 /gateway 会转发到此地址）
# 注意：只需要填到网关根地址，/gateway 前缀会被自动去掉
# 示例：VITE_GATEWAY_TARGET=https://your-company-gateway.example.com
VITE_GATEWAY_TARGET=

# OpenAI 兼容接口配置
# baseURL：接口地址，开发阶段可填 /gateway/v1 走本地代理
VITE_API_BASE_URL=/gateway/v1
# API Key
VITE_API_KEY=
# 文本模型名称
VITE_CHAT_MODEL=
# 图像模型名称
VITE_IMAGE_MODEL=
