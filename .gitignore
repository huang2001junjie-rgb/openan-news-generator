# 依赖
node_modules/
.pnp
.pnp.js
jspm_packages/

# 构建产物
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# 环境变量（含 API Key，勿提交）
.env
.env.*
!.env.example
!.env.template

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
manual-*.log

# 手动测试/实验临时产物
manual-test-*
manual-experiments-*
tmp/
temp/
.cache/

# 测试覆盖率
coverage/
*.lcov
.nyc_output/

# Vite
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 包管理器锁文件（按需保留，如使用 npm 则不要忽略 package-lock.json）
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/
